# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Root build binaries only — anchored so the cmd/gabs source directory (and any
# other path component named "gabs") is NOT ignored.
/gabs
/gabs-*
!skills/
!skills/gabs-mcp/
!skills/gabs-mcp/**

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Distribution folder
dist/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Config files (may contain sensitive data)
*.json
!*schema*.json
!*example*.json
